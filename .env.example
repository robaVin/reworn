# =============================================================================
# ReWorn — Environment template
# =============================================================================
# Copy to `.env.local` (git-ignored) and fill in real values.
# NEVER commit real secrets. Every value here is a PLACEHOLDER.
# Variables are validated at boot by src/lib/env.ts — the app refuses to start
# if a required variable is missing or malformed.
#
# Legend:
#   [public] safe to expose to the browser (NEXT_PUBLIC_*)
#   [server] MUST NEVER reach the browser
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# [public] Absolute base URL of this deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# [public] Project URL and anon key are designed to be browser-visible;
#          they are safe ONLY because Row-Level Security is deny-by-default.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
# [server] Bypasses RLS entirely. Server-only. Never import into a client
#          component. Guarded by src/lib/env.ts + the `server-only` package.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# --- Database (Prisma) ------------------------------------------------------
# [server] Pooled connection used by the app at runtime (PgBouncer, port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# [server] Direct connection used ONLY for migrations (port 5432).
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Authentication ---------------------------------------------------------
# Google OAuth is configured in the Supabase dashboard (Auth > Providers).
# These are only needed if we later verify Google tokens server-side.
# [server]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phone/SMS OTP is architected but DISABLED in Stage 1 (no SMS dependency).
AUTH_PHONE_OTP_ENABLED=false

# --- Payments ---------------------------------------------------------------
# Active gateway. Allowed: "mock" | "casys" | "none"
#   mock  -> local/test/staging ONLY. Hard-blocked in production.
#   casys -> hard-disabled until official bank documentation + credentials.
#   none  -> production default until the real gateway is configured; the UI
#            shows a controlled "payments not yet available" state.
PAYMENT_PROVIDER=mock
# ISO-4217 code. MKD (denar) is the provisional assumption pending bank confirmation.
PAYMENT_CURRENCY=MKD
# Minutes before an unpaid PaymentAttempt expires.
PAYMENT_ATTEMPT_TTL_MINUTES=30

# --- CaSys / bank gateway (NOT YET IMPLEMENTED) -----------------------------
# BLOCKED: the real adapter stays hard-disabled until the bank supplies
# official documentation, signing rules, endpoints, sandbox credentials,
# test cards and merchant credentials.
# No CaSys-specific variables are declared here on purpose — inventing them
# would be guesswork. The full set will be added from the official spec.
CASYS_ENABLED=false

# --- Subscriptions ----------------------------------------------------------
# Grace period after term end during which existing listings stay visible but
# no NEW listings may be published and quota does not reset.
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
# Free trial is modelled in the domain but disabled by default.
SUBSCRIPTION_TRIAL_ENABLED=false
SUBSCRIPTION_TRIAL_DAYS=0

# --- Email (Stage 2+) -------------------------------------------------------
# [server]
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Monitoring -------------------------------------------------------------
# [public] Sentry DSN is publishable by design.
NEXT_PUBLIC_SENTRY_DSN=
# [server]
SENTRY_AUTH_TOKEN=

# --- Security ---------------------------------------------------------------
# Requests per window, per identity, on sensitive endpoints.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
# trace | debug | info | warn | error
LOG_LEVEL=info
