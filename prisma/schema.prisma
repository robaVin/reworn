// =============================================================================
// ReWorn — Prisma schema (Stage 1 database foundation)
// =============================================================================
// Scope (approved): profiles, roles, user_roles, seller_profiles,
// subscription_plans, subscriptions, subscription_events, payment_attempts,
// payment_events, audit_logs, and categories (needed for seed validation).
//
// DEFERRED to later increments: products, variants, product_images, messaging,
// wishlists, reviews, notifications, analytics.
//
// Conventions
//  - PostgreSQL. UUID primary keys for every externally referenced record.
//  - Timestamps are timezone-aware (@db.Timestamptz) and stored in UTC.
//  - Money is INTEGER MINOR UNITS (e.g. denari, cents) + an ISO-4217 code.
//    Never floats — floating point cannot represent money exactly.
//  - We NEVER store passwords, OAuth tokens, OTP values or provider secrets.
//    Authentication lives entirely in Supabase Auth (auth.users); `profiles`
//    references that UUID.
//  - Immutable snapshots (subscription_events, payment_events) are append-only
//    by convention AND enforced by RLS/triggers in the SQL migration.
//  - Idempotency & duplicate-period protection are DATABASE constraints, not
//    just application checks (see @@unique / partial indexes below and the
//    accompanying SQL migration).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Identity & access
// -----------------------------------------------------------------------------

/// Application-side profile for a Supabase Auth user.
/// `id` IS the Supabase Auth user UUID (auth.users.id) — one row per account.
/// No credentials are stored here; authentication is owned by Supabase Auth.
model Profile {
  id          String     @id @db.Uuid // == auth.users.id
  displayName String?    @map("display_name")
  avatarUrl   String?    @map("avatar_url")
  locale      String     @default("mk")
  status      UserStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles         UserRole[]
  sellerProfile SellerProfile?
  auditLogs     AuditLog[]     @relation("AuditActor")

  // Messaging participation (Increment 3A). A profile is the BUYER in some
  // conversations and the SELLER in others; both participant ids are Profile
  // (auth) uuids, so authorization compares uniformly to the verified user id.
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  sentMessages        Message[]      @relation("MessageSender")

  @@index([status])
  @@map("profiles")
}

/// System role catalogue. Small, seeded, rarely changes.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles UserRole[]

  @@map("roles")
}

/// Assignment of a role to a profile (many-to-many).
/// A user may hold several roles (a seller is also a buyer).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Nullable: the Supabase UUID of the admin who granted it (null = system/seed).
  grantedBy String?  @map("granted_by") @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // A profile cannot hold the same role twice.
  @@unique([profileId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// Seller domain
// -----------------------------------------------------------------------------

/// Extended profile for a user who sells. Created when a user opts to sell;
/// seller *privileges* still depend on a server-verified active subscription.
model SellerProfile {
  id         String       @id @default(uuid()) @db.Uuid
  profileId  String       @unique @map("profile_id") @db.Uuid
  /// Public, immutable, lowercase URL slug for /shop/[handle]. Never encodes a
  /// UUID and carries no authorization. Format/reserved-name rules are enforced
  /// in the DB (CHECK, migration 0011) and the app layer (modules/catalog/handle).
  handle     String       @unique @map("handle")
  shopName   String       @map("shop_name")
  isBusiness Boolean      @default(false) @map("is_business")
  status     SellerStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile         Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  paymentAttempts PaymentAttempt[]
  listingUsage    ListingUsage[]
  listings        Listing[]

  @@index([status])
  @@map("seller_profiles")
}

/// Tracks how many listings a seller has created within an ISO week, to enforce
/// the per-plan weekly quota. One row per (seller, iso_year, iso_week).
/// Present in Stage 1 because quota enforcement is part of the subscription
/// domain; product creation that increments it arrives in Stage 2.
model ListingUsage {
  id        String   @id @default(uuid()) @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  isoYear   Int      @map("iso_year")
  isoWeek   Int      @map("iso_week")
  used      Int      @default(0)
  quota     Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Exactly one usage row per seller per ISO week — prevents duplicate quota
  // counters (a required "protection against duplicate quota changes").
  @@unique([sellerId, isoYear, isoWeek])
  @@map("listing_usage")
}

// -----------------------------------------------------------------------------
// Subscription domain
// -----------------------------------------------------------------------------

/// A purchasable plan. Prices are minor units + ISO currency.
/// Seed values are PROVISIONAL and configurable — not approved pricing.
model SubscriptionPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Stable machine code (e.g. "starter"); safe to reference in code/config.
  code               String   @unique
  name               String
  /// Price in MINOR UNITS (e.g. 30000 = 300.00 MKD). Never a float.
  priceMinor         Int      @map("price_minor")
  currency           String   @default("MKD") @db.Char(3)
  /// Billing term length in days (manual-renewal model; no auto-recurring).
  termDays           Int      @map("term_days")
  weeklyListingQuota Int      @map("weekly_listing_quota")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions   Subscription[]
  paymentAttempts PaymentAttempt[]

  @@index([isActive])
  @@map("subscription_plans")
}

/// A seller's subscription. Its lifecycle is governed by the state machine
/// (pending → active → grace_period → expired, plus cancelled/suspended).
model Subscription {
  id       String             @id @default(uuid()) @db.Uuid
  sellerId String             @map("seller_id") @db.Uuid
  planId   String             @map("plan_id") @db.Uuid
  status   SubscriptionStatus @default(pending)

  /// Current paid term window (UTC). Null until first activation.
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  /// End of the configurable grace window after currentPeriodEnd.
  graceEndsAt        DateTime? @map("grace_ends_at") @db.Timestamptz(6)
  /// Set when a cancellation is scheduled to take effect at period end.
  cancelAt           DateTime? @map("cancel_at") @db.Timestamptz(6)

  /// Whether a free trial applied to this subscription (trial disabled by
  /// default at the platform level; modelled for forward compatibility).
  isTrial Boolean @default(false) @map("is_trial")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller          SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  events          SubscriptionEvent[]
  paymentAttempts PaymentAttempt[]

  // Fast lookups for authorization ("is this seller currently allowed to
  // publish?") and for the expiry/grace sweeper.
  @@index([sellerId, status])
  @@index([status, currentPeriodEnd])
  @@index([status, graceEndsAt])
  @@map("subscriptions")
}

/// Immutable, append-only audit trail of every subscription state transition.
/// A financial/lifecycle snapshot; never updated or deleted (enforced by the
/// SQL migration's RLS + revoked UPDATE/DELETE).
model SubscriptionEvent {
  id               String              @id @default(uuid()) @db.Uuid
  subscriptionId   String              @map("subscription_id") @db.Uuid
  fromStatus       SubscriptionStatus? @map("from_status")
  toStatus         SubscriptionStatus  @map("to_status")
  reason           String
  /// Frozen snapshot of relevant fields at event time (period, plan, amount…).
  snapshot         Json?               @db.JsonB
  /// The PaymentAttempt that caused this transition, when applicable.
  paymentAttemptId String?             @map("payment_attempt_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Referential integrity for the causing attempt (added in migration 0003).
  // SetNull: if an attempt is ever purged, the historical event survives with a
  // null reference rather than being deleted or orphaned.
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([paymentAttemptId])
  @@map("subscription_events")
}

// -----------------------------------------------------------------------------
// Payment domain (subscription payments only — no goods checkout)
// -----------------------------------------------------------------------------

/// A single attempt to pay for a subscription term. Created BEFORE redirecting
/// to the gateway. The `merchantReference` is generated by us and is globally
/// unique — it is the idempotency key that guarantees a verified callback
/// activates a subscription EXACTLY ONCE, even under concurrent callbacks.
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid

  /// Globally unique reference we send to the gateway and expect back.
  merchantReference String @unique @map("merchant_reference")

  /// Who is paying (the auth UUID) and their seller/plan/subscription context.
  profileId      String  @map("profile_id") @db.Uuid
  sellerId       String  @map("seller_id") @db.Uuid
  planId         String  @map("plan_id") @db.Uuid
  /// Null until an activation binds the attempt to a concrete subscription.
  subscriptionId String? @map("subscription_id") @db.Uuid

  /// Server-computed expected charge (minor units) + ISO currency. The gateway
  /// callback amount MUST match these — client-supplied amounts are ignored.
  expectedAmountMinor Int    @map("expected_amount_minor")
  expectedCurrency    String @map("expected_currency") @db.Char(3)

  status   PaymentStatus @default(pending)
  provider String // "mock" | "casys" | ...

  /// Provider's own event/transaction id, when returned. Unique when present
  /// (partial unique index in SQL) — a second callback for the same provider
  /// event cannot be processed twice.
  providerReference String? @map("provider_reference")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Attempts expire if the user abandons the redirect.
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set exactly once, when a terminal verified callback is processed.
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  seller             SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  events             PaymentEvent[]
  subscriptionEvents SubscriptionEvent[]

  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@index([subscriptionId])
  @@map("payment_attempts")
}

/// Immutable, append-only record of every callback/status change on an attempt.
/// Reconciliation-ready. Never updated or deleted.
model PaymentEvent {
  id               String           @id @default(uuid()) @db.Uuid
  paymentAttemptId String           @map("payment_attempt_id") @db.Uuid
  type             PaymentEventType
  fromStatus       PaymentStatus?   @map("from_status")
  toStatus         PaymentStatus    @map("to_status")
  /// Provider's event id for this specific callback, when available.
  providerEventId  String?          @map("provider_event_id")
  /// Redacted, non-sensitive snapshot of the callback for audit/reconciliation.
  /// MUST NOT contain signatures, card data or provider secrets.
  payloadSummary   Json?            @map("payload_summary") @db.JsonB
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  attempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@index([paymentAttemptId, createdAt])
  @@map("payment_events")
}

// -----------------------------------------------------------------------------
// Catalogue (minimal — categories only, for seed validation)
// -----------------------------------------------------------------------------

/// Product categories. Included in Stage 1 only to validate the seed/migration
/// pipeline and support hierarchical setup. Products themselves are DEFERRED.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  listings Listing[]

  @@index([parentId])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// Listings (the central domain entity)
// -----------------------------------------------------------------------------

/// A seller's classifieds listing.
///
/// Second-hand items are unique physical pieces, so size/condition/colour live
/// directly on the listing — there is no variants table. The asking price is
/// INFORMATIONAL only: payment and delivery are arranged directly between buyer
/// and seller, never through ReWorn.
///
/// Ownership: a listing belongs to a SellerProfile. All writes go through the
/// authorized listing service (privileged path with explicit ownership +, from
/// Increment 7, subscription/quota entitlement). RLS governs the READ path
/// (public sees published; owner sees own; admin sees all).
model Listing {
  id           String  @id @default(uuid()) @db.Uuid
  sellerId     String  @map("seller_id") @db.Uuid
  /// Per-form-session idempotency key for the auto-draft bootstrap. A unique
  /// constraint makes concurrent "first actions" converge on ONE listing
  /// instead of creating duplicate empty drafts. Null for rows not created via
  /// the bootstrap path (nullable + unique → Postgres allows many NULLs).
  bootstrapKey String? @unique @map("bootstrap_key") @db.Uuid
  /// Nullable so a DRAFT can be saved incomplete; REQUIRED to publish
  /// (enforced by the service's publishable validation + a DB CHECK in 0007).
  categoryId   String? @map("category_id") @db.Uuid

  /// Title is the one field a draft always has (so it is listable in the seller
  /// dashboard). All other content fields may be null on a draft.
  title       String
  description String?
  brand       String?
  size        String?
  color       String?
  material    String?
  condition   ListingCondition?
  gender      ListingGender     @default(unisex)

  /// Asking price in MINOR units (e.g. deni) + ISO-4217 code. Informational.
  priceMinor         Int?   @map("price_minor")
  currency           String @default("MKD") @db.Char(3)
  /// Optional original retail price (minor units), for reference/discount display.
  originalPriceMinor Int?   @map("original_price_minor")

  location String?

  status      ListingStatus @default(draft)
  /// Set the first time the listing is published; retained thereafter.
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Full-text search vector — a GENERATED column (migration 0012). Declared as
  /// an ignored Unsupported field so Prisma is AWARE of the column (no
  /// column-drop drift) but never reads or writes it; the weighted vector +
  /// GIN index are owned entirely by the hand-written migration.
  searchVector Unsupported("tsvector")? @map("search_vector")

  seller        SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ListingImage[]
  conversations Conversation[]

  // Seller-dashboard path. The PUBLIC browse path (published-only keyset by
  // created_at/price/category/location + a GIN full-text index and a generated
  // `search_vector` column) is served by PARTIAL indexes created in migration
  // 0012 — they cannot be expressed in Prisma schema and live in raw SQL.
  @@index([sellerId, status])
  @@map("listings")
}

/// A processed image belonging to a listing.
///
/// Storage keys are RANDOM (never the original filename). Files are stored in a
/// private Supabase Storage bucket and read via short-lived signed URLs issued
/// by the server. Uploads are validated (magic bytes, size, dimensions),
/// EXIF-stripped, orientation-normalised and re-encoded server-side before they
/// reach storage. `position` is 0-based; the cover image is position 0.
model ListingImage {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  /// Random storage object key (path in the private bucket). Never a filename.
  storageKey String   @unique @map("storage_key")
  position   Int
  width      Int
  height     Int
  byteSize   Int      @map("byte_size")
  mimeType   String   @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_images")
}

// -----------------------------------------------------------------------------
// Messaging (Increment 3A) — buyer ↔ seller conversations about a listing
// -----------------------------------------------------------------------------

/// A conversation between a buyer and a seller about ONE listing.
///
/// Identity is (listingId, buyerProfileId, sellerProfileId) — a database UNIQUE
/// makes get-or-create idempotent and race-safe (the service catches the unique
/// violation and returns the winner). Both participant ids are Profile (auth)
/// uuids; `sellerProfileId` is the listing owner's Profile id, derived
/// server-side at creation — never supplied by the client.
///
/// Access is participant-based and INDEPENDENT of listing status: a conversation
/// started from a published listing stays reachable to its two participants even
/// if the listing is later paused/archived. New conversations, however, may only
/// be created from a currently-published listing. All writes go through the
/// privileged messaging service; RLS is the read-path backstop.
model Conversation {
  id              String @id @default(uuid()) @db.Uuid
  listingId       String @map("listing_id") @db.Uuid
  /// The buyer's Profile (auth) id. The user who started the conversation.
  buyerProfileId  String @map("buyer_profile_id") @db.Uuid
  /// The seller's Profile (auth) id == the listing owner's SellerProfile.profileId.
  sellerProfileId String @map("seller_profile_id") @db.Uuid

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Latest-activity timestamp for inbox ordering. Seeded to created_at, then
  /// bumped to the newest message's created_at by an AFTER INSERT trigger on
  /// `messages` (migration 0013) so it updates ATOMICALLY with the insert — never
  /// a separate application step that could fail after the message is written.
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    Profile   @relation("BuyerConversations", fields: [buyerProfileId], references: [id], onDelete: Cascade)
  seller   Profile   @relation("SellerConversations", fields: [sellerProfileId], references: [id], onDelete: Cascade)
  messages Message[]

  // Idempotent identity: one conversation per (listing, buyer, seller).
  @@unique([listingId, buyerProfileId, sellerProfileId], map: "conversations_identity_key")
  // Inbox keyset: a participant's conversations by latest activity (desc, desc).
  @@index([buyerProfileId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_buyer_activity_idx")
  @@index([sellerProfileId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_seller_activity_idx")
  @@map("conversations")
}

/// A single plain-text message in a conversation. Append-only in 3A (editing and
/// deletion are deferred). `senderProfileId` is the verified author and MUST be
/// one of the conversation's two participants — enforced by a BEFORE INSERT
/// trigger (migration 0013) as well as by the service.
model Message {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  senderProfileId String   @map("sender_profile_id") @db.Uuid
  /// Plain text only. Normalised (LF line endings, trimmed, control chars
  /// rejected) and length-bounded by the service; a DB CHECK is the backstop.
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation("MessageSender", fields: [senderProfileId], references: [id], onDelete: Cascade)

  // Deterministic chronological retrieval + keyset pagination within a conversation.
  @@index([conversationId, createdAt, id], map: "messages_conversation_chrono_idx")
  @@map("messages")
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

/// Append-only audit log for security-sensitive actions. Immutable.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// The auth UUID of the actor (null for system/automated actions).
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  /// Redacted contextual detail. MUST NOT contain secrets or sensitive PII.
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum RoleName {
  buyer
  seller
  admin

  @@map("role_name")
}

enum SellerStatus {
  active
  frozen
  banned

  @@map("seller_status")
}

/// Subscription lifecycle. Transitions are validated by the state machine and
/// recorded immutably in subscription_events.
enum SubscriptionStatus {
  pending
  active
  grace_period
  expired
  cancelled
  suspended

  @@map("subscription_status")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  cancelled

  @@map("payment_status")
}

enum PaymentEventType {
  created
  callback_received
  verified
  rejected
  expired

  @@map("payment_event_type")
}

/// Listing lifecycle. Transitions are validated by the listing state machine
/// (src/modules/catalog/listing-status.ts) and enforced server-side.
enum ListingStatus {
  draft
  published
  paused
  archived

  @@map("listing_status")
}

enum ListingCondition {
  new
  like_new
  very_good
  good
  fair

  @@map("listing_condition")
}

enum ListingGender {
  women
  men
  kids
  unisex

  @@map("listing_gender")
}
